"""
blueprints/public/routes.py
───────────────────────────
Home, About, and Contact pages for the public site.

These are the "front door" pages — the first thing visitors see. They
need to load fast and work without authentication.

ROUTES
    GET /          index        landing page with featured content
    GET /about     about        static about-us page
    GET /contact   contact      contact form (POSTs to enquiry_routes)

DESIGN NOTES
    - Home page queries a small number of featured items from each
      product type. We sort by id for determinism and use `limit` to
      keep the query cheap.
    - Counts (activities / hotels / packages / destinations) are cheap
      `SELECT COUNT(*)` aggregates — safe to run on every page load.
    - Templates live under templates/public/.
    - No auth required on any of these routes.
"""

from __future__ import annotations

from flask import current_app, render_template
from sqlalchemy import func, select

from blueprints.public import public_bp
from extensions import db
from models import (
    Activity,
    ActivityPrice,
    Destination,
    Hotel,
    Package,
    PackagePrice,
    Room,
)


# ─── Home ──────────────────────────────────────────────────────────
# ─── Home page helpers ────────────────────────────────────────────
def _cheapest_per_destination(model, price_getter, limit=6):
    """
    Return up to `limit` model instances - each from a DISTINCT destination,
    keeping the CHEAPEST one per destination.

    `price_getter` is a callable that takes the model instance and returns
    a float price (or None). Items with no price are skipped.
    """
    rows = list(db.session.scalars(
        select(model).where(model.is_active.is_(True))
    ))
    # Group by destination, keep the cheapest item per destination
    best: dict[int | None, tuple] = {}
    for obj in rows:
        try:
            price = price_getter(obj)
        except Exception:
            price = None
        if price is None:
            continue
        dest = getattr(obj, "destination_id", None)
        if dest not in best or price < best[dest][0]:
            best[dest] = (price, obj)
    # Sort by price ascending, take the top `limit`
    ordered = sorted(best.values(), key=lambda t: t[0])
    # Return dicts with both the object and its cheapest price
    return [
        {"obj": obj, "price": round(float(price), 2)}
        for price, obj in ordered[:limit]
    ]


def _hotel_price(obj):
    """Cheapest active room price for a hotel, in float."""
    from sqlalchemy import func as _f
    row = db.session.scalar(
        select(_f.min(Room.base_price_per_night)).where(
            Room.hotel_id == obj.id,
            Room.is_active.is_(True),
            Room.base_price_per_night > 0,
        )
    )
    return float(row) if row else None


def _package_price(obj):
    """Cheapest PackagePrice for a package, in float."""
    from sqlalchemy import func as _f
    row = db.session.scalar(
        select(_f.min(PackagePrice.adult_price)).where(
            PackagePrice.package_id == obj.id
        )
    )
    return float(row) if row else None


def _activity_price(obj):
    """Cheapest ActivityPrice for an activity, in float."""
    from sqlalchemy import func as _f
    row = db.session.scalar(
        select(_f.min(ActivityPrice.adult_price)).where(
            ActivityPrice.activity_id == obj.id
        )
    )
    return float(row) if row else None


@public_bp.route("/")
def index():
    """
    Landing page.

    Shows:
      - Featured activities (6)
      - Featured hotels (3)
      - Featured packages (3)
      - Top destinations (8)
      - Site-wide counts for the hero band
    """
    # ─── Featured content: cheapest per destination, 6 each ───
    try:
        featured_hotels = _cheapest_per_destination(Hotel, _hotel_price, limit=6)
    except Exception as exc:
        current_app.logger.warning("featured_hotels failed: %s", exc)
        featured_hotels = []

    try:
        featured_packages = _cheapest_per_destination(Package, _package_price, limit=6)
    except Exception as exc:
        current_app.logger.warning("featured_packages failed: %s", exc)
        featured_packages = []

    try:
        featured_activities = _cheapest_per_destination(Activity, _activity_price, limit=6)
    except Exception as exc:
        current_app.logger.warning("featured_activities failed: %s", exc)
        featured_activities = []

    top_destinations = list(
        db.session.scalars(
            select(Destination).order_by(Destination.name).limit(6)
        )
    )

    # ─── Destination images (admin-managed, best-effort) ───
    destination_images = {}
    try:
        from services import content_service
        destination_images = content_service.all_destination_images()
    except Exception as exc:
        current_app.logger.debug("destination images unavailable: %s", exc)

    counts = {
        "activities": db.session.scalar(
            select(func.count(Activity.id)).where(Activity.is_active.is_(True))
        ) or 0,
        "hotels": db.session.scalar(
            select(func.count(Hotel.id)).where(Hotel.is_active.is_(True))
        ) or 0,
        "packages": db.session.scalar(
            select(func.count(Package.id)).where(Package.is_active.is_(True))
        ) or 0,
        "destinations": db.session.scalar(
            select(func.count(Destination.id))
        ) or 0,
    }

    return render_template(
        "public/index.html",
        destination_images=destination_images,
        featured_activities=featured_activities,
        featured_hotels=featured_hotels,
        featured_packages=featured_packages,
        top_destinations=top_destinations,
        counts=counts,
    )


# ─── About ─────────────────────────────────────────────────────────
@public_bp.route("/about")
def about():
    """Static About-us page."""
    return render_template("public/about.html")


# ─── Contact ───────────────────────────────────────────────────────
@public_bp.route("/contact")
def contact():
    """
    Contact page.

    The form on this page POSTs to /enquiries (handled in
    enquiry_routes.py). This GET handler just renders the page.
    """
    return render_template("public/contact.html")
