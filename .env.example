# ═══════════════════════════════════════════════════════════════════
#  eltut-tours-platform — .env.example
#  Copy to .env  →  NEVER commit .env
# ═══════════════════════════════════════════════════════════════════

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-hex-string

SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ENGINE_OPTIONS_POOL_PRE_PING=True
SQLALCHEMY_ENGINE_OPTIONS_POOL_RECYCLE=300

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=eltut_tours

MAIL_SERVER=smtp.ionos.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=bookings@eltuttours.com
MAIL_PASSWORD=your-ionos-smtp-password
MAIL_DEFAULT_SENDER=bookings@eltuttours.com
MAIL_ADMIN_RECIPIENT=admin@eltuttours.com

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://localhost:5000/booking/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5000/booking/paypal/cancel

CLOUD_FUNCTION_URL=https://your-cloud-function-url/booking-created
CLOUD_FUNCTION_SECRET=shared-hmac-secret

ADMIN_EMAIL=admin@eltuttours.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=ElTut Admin

APP_NAME=ElTut Tours
APP_BASE_URL=http://localhost:5000
ITEMS_PER_PAGE=12
UPLOAD_FOLDER=static/images/uploads
MAX_CONTENT_LENGTH=16777216
