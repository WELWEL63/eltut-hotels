# ─── Registry ─────────────────────────────────────────────────────────────
@dataclass(frozen=True)
class ContentSpec:
    """Spec for one editable content key."""
    key: str
    page: str
    label: str
    default: str
    content_type: str = CONTENT_TYPE_TEXT
    notes: str = ""
    sort_order: int = 0


