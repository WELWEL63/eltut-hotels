{% extends "base.html" %}

{% block title %}
    {% if result['destination'] %}{{ result['destination'].name }}{% else %}Search{% endif %}
    — {{ result['product_type']|capitalize }}s — {{ config.APP_NAME }}
{% endblock %}

{% block content %}

<section class="hero-eltut py-4 position-relative">
    <div class="container position-relative">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a href="{{ url_for('public.index') }}"
                       class="text-white-50 text-decoration-none">
                        Home
                    </a>
                </li>
                <li class="breadcrumb-item text-white-50 active" aria-current="page">
                    Search
                </li>
                {% if result['destination'] %}
                    <li class="breadcrumb-item text-white-50 active" aria-current="page">
                        {{ result['destination'].name }}
                    </li>
                {% endif %}
            </ol>
        </nav>

        <div class="row align-items-end g-3">
            <div class="col-lg-8">
                <h1 class="mb-2">
                    {% if result['destination'] %}
                        {{ result['destination'].name }}
                    {% else %}
                        Explore all destinations
                    {% endif %}
                </h1>
                <p class="lead mb-0 opacity-75 d-flex align-items-center gap-3 flex-wrap">
                    <span>
                        <i class="bi bi-collection"></i>
                        <strong>{{ result['total'] }}</strong>
                        {{ result['product_type'] }}{{ "" if result['total'] == 1 else "s" }}
                        found
                    </span>
                    {% if result['filters'].party_size %}
                        <span>
                            <i class="bi bi-people"></i>
                            {{ result['filters'].party_size }}
                            traveller{{ "" if result['filters'].party_size == 1 else "s" }}
                        </span>
                    {% endif %}
                    {% if result['filters'].check_in and result['filters'].check_out %}
                        <span>
                            <i class="bi bi-calendar-range"></i>
                            {{ result['filters'].check_in }} to {{ result['filters'].check_out }}
                        </span>
                    {% elif result['filters'].activity_date %}
                        <span>
                            <i class="bi bi-calendar-event"></i>
                            {{ result['filters'].activity_date }}
                        </span>
                    {% endif %}
                </p>
            </div>
        </div>

        <div class="mt-4">
            {% include "public/_search_widget.html" %}
        </div>
    </div>
</section>

<section class="py-3 bg-white border-bottom shadow-sm">
    <div class="container">
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="text-muted small me-2 d-none d-md-inline">
                <i class="bi bi-funnel"></i> Search type:
            </span>
            {% set other_qs = {
                'destination': qs.destination,
                'check_in':    qs.check_in,
                'check_out':   qs.check_out,
                'date':        qs.date,
                'adults':      qs.adults,
                'children':    qs.children,
                'sort':        qs.sort,
            } %}
            {% for t, icon, label in [
                ('hotel',    'building',    'Hotels'),
                ('package',  'suitcase-lg', 'Packages'),
                ('activity', 'compass',     'Activities'),
            ] %}
                <a href="{{ url_for('public.search_results', type=t, **other_qs) }}"
                   class="btn btn-sm {% if result['product_type'] == t %}btn-eltut-primary{% else %}btn-outline-secondary{% endif %} rounded-pill px-3">
                    <i class="bi bi-{{ icon }}"></i> {{ label }}
                </a>
            {% endfor %}
        </div>
    </div>
</section>

<section class="py-5" style="background:#f7f7f9;">
    <div class="container">
        <div class="row g-4">

            <aside class="col-lg-3">
                <form method="GET" action="{{ url_for('public.search_results') }}"
                      class="card border-0 shadow-sm p-4 sticky-top"
                      style="top: 1rem;">
                    <input type="hidden" name="type" value="{{ result['product_type'] }}">
                    <input type="hidden" name="destination" value="{{ qs.destination }}">
                    <input type="hidden" name="check_in" value="{{ qs.check_in }}">
                    <input type="hidden" name="check_out" value="{{ qs.check_out }}">
                    <input type="hidden" name="date" value="{{ qs.date }}">
                    <input type="hidden" name="adults" value="{{ qs.adults }}">
                    <input type="hidden" name="children" value="{{ qs.children }}">

                    <h5 class="mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-sliders"></i> Refine your search
                    </h5>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase text-muted">
                            Sort by
                        </label>
                        <select name="sort" class="form-select">
                            {% for v, label in [
                                ('newest',       'Newest first'),
                                ('name',         'Name (A to Z)'),
                                ('price_asc',    'Price - low to high'),
                                ('price_desc',   'Price - high to low'),
                                ('stars_desc',   'Star rating'),
                                ('duration_asc', 'Shortest duration'),
                            ] %}
                                {% if result['product_type'] == 'hotel' or v in ['newest', 'name', 'price_asc', 'price_desc'] or (result['product_type'] == 'package' and v == 'duration_asc') %}
                                    <option value="{{ v }}" {% if qs.sort == v %}selected{% endif %}>
                                        {{ label }}
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase text-muted">
                            <i class="bi bi-geo-alt"></i> Destination
                        </label>
                        <select name="destination" class="form-select">
                            <option value="">Any destination</option>
                            {% for d in destinations %}
                                <option value="{{ d.slug }}"
                                        {% if qs.destination == d.slug %}selected{% endif %}>
                                    {{ d.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase text-muted">
                            <i class="bi bi-people"></i> Travellers
                        </label>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="number" name="adults" class="form-control"
                                           value="{{ qs.adults }}" min="1" placeholder="Adults">
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person-heart"></i></span>
                                    <input type="number" name="children" class="form-control"
                                           value="{{ qs.children }}" min="0" placeholder="Kids">
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if result['product_type'] in ['hotel', 'package'] %}
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-uppercase text-muted">
                                <i class="bi bi-calendar-range"></i> Dates
                            </label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="date" name="check_in" class="form-control"
                                           value="{{ qs.check_in }}">
                                </div>
                                <div class="col-6">
                                    <input type="date" name="check_out" class="form-control"
                                           value="{{ qs.check_out }}">
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-uppercase text-muted">
                                <i class="bi bi-calendar-event"></i> Date
                            </label>
                            <input type="date" name="date" class="form-control"
                                   value="{{ qs.date }}">
                        </div>
                    {% endif %}

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-eltut-primary">
                            <i class="bi bi-check2-circle"></i> Apply filters
                        </button>
                        {% if qs.destination or qs.q or qs.check_in or qs.date %}
                            <a href="{{ url_for('public.search_results', type=result['product_type']) }}"
                               class="btn btn-link btn-sm text-decoration-none">
                                <i class="bi bi-x-circle"></i> Clear all filters
                            </a>
                        {% endif %}
                    </div>
                </form>
            </aside>

            <div class="col-lg-9">

                {% if result['ignored'] %}
                    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Some filters were ignored:</strong>
                            {{ result['ignored']|join(', ') }}.
                            <span class="text-muted small">Try different values.</span>
                        </div>
                    </div>
                {% endif %}

                {% if result['items'] %}
                    <div class="row g-4">
                        {% for item in result['items'] %}
                            <div class="col-md-6 col-xxl-4">
                                <article class="card card-lift h-100 border-0 shadow-sm overflow-hidden result-card">

                                    <div class="position-relative">
                                        {% if item.image_url %}
                                            <img src="{{ item.image_url }}"
                                                 class="card-img-top result-card-img"
                                                 alt="{{ item.name }}"
                                                 style="height:220px; object-fit:cover;">
                                        {% else %}
                                            {% set placeholder_icon = {'hotel': 'building', 'package': 'suitcase-lg', 'activity': 'compass'}[result['product_type']] %}
                                            <div class="card-img-top d-flex align-items-center justify-content-center result-card-placeholder"
                                                 style="height:220px; background: linear-gradient(135deg, #eef2f7 0%, #dfe7ef 100%);">
                                                <i class="bi bi-{{ placeholder_icon }} text-muted" style="font-size:4rem; opacity:.55;"></i>
                                            </div>
                                        {% endif %}

                                        {% if item.destination_name %}
                                            <div class="position-absolute top-0 start-0 m-2">
                                                <span class="badge bg-white text-dark shadow-sm">
                                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                                    {{ item.destination_name }}
                                                </span>
                                            </div>
                                        {% endif %}

                                        {% if item.nights and item.nights > 0 %}
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-dark bg-opacity-75">
                                                    <i class="bi bi-moon-stars"></i>
                                                    {{ item.nights }} night{{ "" if item.nights == 1 else "s" }}
                                                </span>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <div class="card-body d-flex flex-column">

                                        <h5 class="card-title mb-2 result-card-title">
                                            {{ item.name }}
                                        </h5>

                                        <div class="d-flex flex-wrap gap-2 small mb-3">
                                            {% if result['product_type'] == 'hotel' %}
                                                {% if item.extra.stars %}
                                                    <span class="text-warning">
                                                        {% for _ in range(item.extra.stars) %}
                                                            <i class="bi bi-star-fill"></i>
                                                        {% endfor %}
                                                    </span>
                                                    <span class="text-muted">{{ item.extra.stars }} star</span>
                                                {% endif %}
                                                {% if item.extra.check_in_time %}
                                                    <span class="text-muted">
                                                        <i class="bi bi-box-arrow-in-right"></i>
                                                        {{ item.extra.check_in_time }}
                                                    </span>
                                                {% endif %}
                                            {% elif result['product_type'] == 'package' %}
                                                {% if item.extra.package_type %}
                                                    <span class="badge bg-light text-dark border">
                                                        {{ item.extra.package_type|title }}
                                                    </span>
                                                {% endif %}
                                                {% if item.extra.code %}
                                                    <span class="text-muted">
                                                        <i class="bi bi-hash"></i>{{ item.extra.code }}
                                                    </span>
                                                {% endif %}
                                            {% else %}
                                                {% if item.extra.category %}
                                                    <span class="badge bg-light text-dark border">
                                                        {{ item.extra.category|title }}
                                                    </span>
                                                {% endif %}
                                                {% if item.extra.duration_hours %}
                                                    <span class="text-muted">
                                                        <i class="bi bi-clock"></i>
                                                        {{ item.extra.duration_hours }}h
                                                    </span>
                                                {% endif %}
                                                {% if item.extra.difficulty %}
                                                    <span class="text-muted">
                                                        <i class="bi bi-bar-chart"></i>
                                                        {{ item.extra.difficulty|title }}
                                                    </span>
                                                {% endif %}
                                            {% endif %}
                                        </div>

                                        <div class="mt-auto">
                                            {% if item.total_price is not none and item.total_price > 0 %}
                                                <div class="price-panel rounded-3 p-3 mb-3">

                                                    <div class="d-flex align-items-baseline justify-content-between flex-wrap gap-2">
                                                        <div>
                                                            <div class="small text-muted mb-1">
                                                                <i class="bi bi-cash-stack"></i>
                                                                Total for your stay
                                                            </div>
                                                            <div class="price-amount fw-bold"
                                                                 style="font-size:1.75rem; line-height:1; color:var(--eltut-primary, #c0392b);">
                                                                {{ item.currency }} {{ "%.2f"|format(item.total_price) }}
                                                            </div>
                                                        </div>
                                                        {% if item.nights %}
                                                            <div class="text-end small text-muted">
                                                                <div>
                                                                    {{ item.currency }}
                                                                    {{ "%.2f"|format(item.price_per_night or 0) }}
                                                                    / night
                                                                </div>
                                                                <div>
                                                                    x {{ item.nights }}
                                                                    night{{ "" if item.nights == 1 else "s" }}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    </div>

                                                    <hr class="my-2 opacity-25">

                                                    <div class="small text-muted d-flex flex-wrap gap-3">
                                                        <span>
                                                            <i class="bi bi-people-fill"></i>
                                                            {{ item.adults }} adult{{ "" if item.adults == 1 else "s" }}
                                                            {% if item.children %}
                                                                + {{ item.children }} child{{ "" if item.children == 1 else "ren" }}
                                                            {% endif %}
                                                        </span>
                                                        {% if item.price_adult %}
                                                            <span>
                                                                <i class="bi bi-person"></i>
                                                                {{ item.currency }} {{ "%.2f"|format(item.price_adult) }}
                                                                {% if item.price_basis == 'per_night' %}/night{% endif %}
                                                            </span>
                                                        {% endif %}
                                                        {% if item.price_child and item.price_child > 0 %}
                                                            <span>
                                                                <i class="bi bi-person-heart"></i>
                                                                {{ item.currency }} {{ "%.2f"|format(item.price_child) }}
                                                                {% if item.price_basis == 'per_night' %}/night{% endif %}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                            {% elif item.price_adult is not none %}
                                                <div class="price-pill mb-3">
                                                    <span class="small text-muted">from</span>
                                                    <span class="price-amount">
                                                        {{ item.currency }} {{ "%.2f"|format(item.price_adult) }}
                                                    </span>
                                                    <span class="small text-muted">
                                                        {% if item.price_basis == 'per_night' %}per night{% else %}per person{% endif %}
                                                    </span>
                                                </div>
                                            {% else %}
                                                <div class="alert alert-light border py-2 small text-muted mb-3">
                                                    <i class="bi bi-info-circle"></i>
                                                    Price on request
                                                </div>
                                            {% endif %}
                                        </div>

                                    </div>

                                    <div class="card-footer bg-white border-top-0 pt-0">
                                        {% set _link_args = {'slug': item.slug} %}
                                        {% if result['product_type'] == 'activity' %}
                                            {% if item.check_in %}{% set _ = _link_args.update({'date': item.check_in}) %}{% endif %}
                                        {% else %}
                                            {% if item.check_in %}{% set _ = _link_args.update({'check_in': item.check_in}) %}{% endif %}
                                            {% if item.check_out %}{% set _ = _link_args.update({'check_out': item.check_out}) %}{% endif %}
                                        {% endif %}
                                        {% if item.adults %}{% set _ = _link_args.update({'adults': item.adults}) %}{% endif %}
                                        {% if item.children is not none %}{% set _ = _link_args.update({'children': item.children}) %}{% endif %}

                                        {% if result['product_type'] == 'hotel' %}
                                            <a href="{{ url_for('public.hotel_detail', **_link_args) }}"
                                               class="btn btn-eltut-primary w-100">
                                                View details <i class="bi bi-arrow-right"></i>
                                            </a>
                                        {% elif result['product_type'] == 'package' %}
                                            <a href="{{ url_for('public.package_detail', **_link_args) }}"
                                               class="btn btn-eltut-primary w-100">
                                                View details <i class="bi bi-arrow-right"></i>
                                            </a>
                                        {% else %}
                                            <a href="{{ url_for('public.activity_detail', **_link_args) }}"
                                               class="btn btn-eltut-primary w-100">
                                                View details <i class="bi bi-arrow-right"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </article>
                            </div>
                        {% endfor %}
                    </div>

                    {% if result.total_pages > 1 %}
                        <nav class="mt-5">
                            <ul class="pagination justify-content-center">
                                <li class="page-item {% if result['page'] <= 1 %}disabled{% endif %}">
                                    <a class="page-link"
                                       href="{{ url_for('public.search_results', page=result['page']-1, **qs) }}">
                                        <i class="bi bi-chevron-left"></i> Previous
                                    </a>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">
                                        Page {{ result['page'] }} of {{ result['total_pages'] }}
                                    </span>
                                </li>
                                <li class="page-item {% if result['page'] >= result['total_pages'] %}disabled{% endif %}">
                                    <a class="page-link"
                                       href="{{ url_for('public.search_results', page=result['page']+1, **qs) }}">
                                        Next <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    {% endif %}

                {% else %}
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-5">
                            <div class="display-1 text-muted mb-3" style="opacity:.35;">
                                <i class="bi bi-binoculars"></i>
                            </div>
                            <h3 class="mb-2">No matches found</h3>
                            <p class="text-muted mb-4 mx-auto" style="max-width: 420px;">
                                We could not find any {{ result['product_type'] }}s matching your
                                criteria. Try widening your dates, changing destinations, or
                                reducing the party size.
                            </p>
                            <a href="{{ url_for('public.search_results', type=result['product_type']) }}"
                               class="btn btn-eltut-primary">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset search
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

{% endblock %}
