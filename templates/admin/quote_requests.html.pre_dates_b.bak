{% extends "admin/base.html" %}
{% block title %}Quote Requests — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <a href="{{ url_for('admin.quote_list') }}" class="text-decoration-none small">
            <i class="bi bi-arrow-left"></i> All quotes
        </a>
        <h1 class="mb-0">Requests inbox</h1>
        <p class="text-muted mb-0">
            Customer-submitted quote requests waiting to be priced.
            {{ total }} open.
        </p>
    </div>
</div>

{% if not mongo_available %}
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>MongoDB is not configured.</strong>
        The requests inbox reads from the Mongo `enquiries` collection.
        Configure MONGO_URI in .env to see incoming requests.
    </div>
{% endif %}

{% if items %}
    <div class="row g-3">
        {% for e in items %}
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="badge bg-info-subtle text-info-emphasis">
                            {{ e.type }}
                        </span>
                        <span class="small text-muted">
                            {{ e.created_at.strftime("%Y-%m-%d %H:%M") if e.created_at else "—" }}
                        </span>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title mb-1">
                            {{ e.name or "—" }}
                        </h6>
                        <div class="small text-muted mb-2">
                            <a href="mailto:{{ e.email }}" class="text-decoration-none">
                                <i class="bi bi-envelope"></i> {{ e.email }}
                            </a>
                            {% if e.phone %}
                                &middot;
                                <a href="tel:{{ e.phone }}" class="text-decoration-none">
                                    <i class="bi bi-telephone"></i> {{ e.phone }}
                                </a>
                            {% endif %}
                        </div>

                        {% if e.product_type %}
                            <div class="mb-2">
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    {{ e.product_type }} #{{ e.product_id }}
                                </span>
                            </div>
                        {% endif %}

                        {% if e.metadata %}
                            <div class="small mb-2">
                                {% if e.metadata.adults %}
                                    <i class="bi bi-people"></i>
                                    {{ e.metadata.adults }} adult(s)
                                    {% if e.metadata.children %}, {{ e.metadata.children }} child(ren){% endif %}
                                {% endif %}
                                {% if e.metadata.preferred_start %}
                                    <div class="mt-1">
                                        <i class="bi bi-calendar"></i>
                                        {{ e.metadata.preferred_start }}
                                        {% if e.metadata.preferred_end %}
                                            → {{ e.metadata.preferred_end }}
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if e.message %}
                            <div class="small border-start ps-2 text-muted" style="max-height:100px; overflow:auto; white-space:pre-wrap;">{{ e.message }}</div>
                        {% endif %}
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                        <a href="{{ url_for('admin.quote_new',
                                             email=e.email,
                                             name=e.name or '',
                                             phone=e.phone or '',
                                             product_type=e.product_type or 'package',
                                             product_id=e.product_id or '',
                                             enquiry_id=e._id|string) }}"
                           class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle"></i> Create quote
                        </a>
                        <form method="POST"
                              action="{{ url_for('admin.enquiry_status', enquiry_id=e._id|string) }}"
                              class="d-inline"
                              onsubmit="return confirm('Mark this request as handled without creating a quote?')">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="status" value="handled">
                            <button class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-check2"></i> Dismiss
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if total_pages > 1 %}
        <nav class="mt-4">
            <ul class="pagination">
                <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                    <a class="page-link" href="{{ url_for('admin.quote_requests', page=page-1) }}">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page {{ page }} of {{ total_pages }}</span>
                </li>
                <li class="page-item {% if page >= total_pages %}disabled{% endif %}">
                    <a class="page-link" href="{{ url_for('admin.quote_requests', page=page+1) }}">Next</a>
                </li>
            </ul>
        </nav>
    {% endif %}

{% else %}
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size:3rem;"></i>
            <h5 class="mt-3">No open requests</h5>
            <p class="small mb-0">
                {% if mongo_available %}
                    When customers submit a request-a-quote form, it lands here.
                {% else %}
                    Configure MongoDB to see incoming quote requests.
                {% endif %}
            </p>
        </div>
    </div>
{% endif %}

{# ─── Quick reminder of the workflow ─── #}
<div class="card shadow-sm mt-4">
    <div class="card-header bg-white"><strong>What happens next</strong></div>
    <div class="card-body small">
        <ol class="mb-0">
            <li>Click <strong>Create quote</strong> → opens a draft with the customer and product prefilled.</li>
            <li>Fill in the price, message, and validity date, then click <strong>Send</strong>.</li>
            <li>The customer receives an email with a link to view, accept, or decline.</li>
            <li>If they accept, a pending booking is created automatically.</li>
        </ol>
    </div>
</div>
{% endblock %}
