{% extends "admin/base.html" %}
{% block title %}Enquiries — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Enquiries</h1>
        <p class="text-muted mb-0">
            {{ total }} enquir{{ "y" if total == 1 else "ies" }}
        </p>
    </div>
</div>

{% if not mongo_available %}
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>MongoDB is not configured.</strong>
        Enquiries are unavailable in this environment.
        {% if mongo_error %}<div class="small mt-1"><code>{{ mongo_error }}</code></div>{% endif %}
    </div>
{% endif %}

{# ─── Filters ─── #}
<form method="GET" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <select name="type" class="form-select">
                    <option value="">Any type</option>
                    <option value="quote_request" {% if type_filter == "quote_request" %}selected{% endif %}>Quote request</option>
                    <option value="contact"       {% if type_filter == "contact" %}selected{% endif %}>Contact message</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">Any status</option>
                    <option value="new"     {% if status_filter == "new" %}selected{% endif %}>New</option>
                    <option value="handled" {% if status_filter == "handled" %}selected{% endif %}>Handled</option>
                    <option value="spam"    {% if status_filter == "spam" %}selected{% endif %}>Spam</option>
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-primary w-100">Filter</button>
            </div>
        </div>
    </div>
</form>

{# ─── Table ─── #}
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Type</th>
                    <th>From</th>
                    <th>Product</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for e in items %}
                    <tr>
                        <td class="small">
                            {{ e.created_at.strftime("%Y-%m-%d %H:%M") if e.created_at else "—" }}
                        </td>
                        <td><code>{{ e.type }}</code></td>
                        <td>
                            <div>{{ e.name or "—" }}</div>
                            <div class="small text-muted">{{ e.email or "—" }}</div>
                            {% if e.phone %}<div class="small text-muted">{{ e.phone }}</div>{% endif %}
                        </td>
                        <td class="small">
                            {% if e.product_type %}
                                {{ e.product_type }} #{{ e.product_id }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="small">
                            {{ (e.message or "")[:100] }}{% if (e.message or "")|length > 100 %}…{% endif %}
                        </td>
                        <td>
                            {% set badge = {
                                "new":     "warning",
                                "handled": "success",
                                "spam":    "danger"
                            }.get(e.status, "secondary") %}
                            <span class="badge bg-{{ badge }}">{{ e.status }}</span>
                        </td>
                        <td class="text-end">
                            {% if e.status == "new" %}
                                <form method="POST"
                                      action="{{ url_for('admin.enquiry_status', enquiry_id=e._id) }}"
                                      class="d-inline">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="status" value="handled">
                                    <button class="btn btn-sm btn-outline-success" title="Mark handled">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                                <form method="POST"
                                      action="{{ url_for('admin.enquiry_status', enquiry_id=e._id) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Mark this enquiry as spam?')">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="status" value="spam">
                                    <button class="btn btn-sm btn-outline-danger" title="Mark spam">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                </form>
                            {% else %}
                                <span class="text-muted small">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            {% if mongo_available %}
                                No enquiries match these filters.
                            {% else %}
                                Cannot load enquiries — MongoDB unavailable.
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ─── Pagination ─── #}
{% if total_pages > 1 %}
    <nav class="mt-3">
        <ul class="pagination">
            {% set qs = {} %}
            {% if type_filter %}{% set _ = qs.update({"type": type_filter}) %}{% endif %}
            {% if status_filter %}{% set _ = qs.update({"status": status_filter}) %}{% endif %}

            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                <a class="page-link" href="{{ url_for('admin.enquiry_list', page=page-1, **qs) }}">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page {{ page }} of {{ total_pages }}</span>
            </li>
            <li class="page-item {% if page >= total_pages %}disabled{% endif %}">
                <a class="page-link" href="{{ url_for('admin.enquiry_list', page=page+1, **qs) }}">Next</a>
            </li>
        </ul>
    </nav>
{% endif %}
{% endblock %}
