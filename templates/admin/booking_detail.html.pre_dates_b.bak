{% extends "admin/base.html" %}
{% block title %}Booking {{ booking.reference }} — Admin{% endblock %}

{% block admin_content %}
{# ─── Header ─── #}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <a href="{{ url_for('admin.booking_list') }}" class="text-decoration-none small">
            <i class="bi bi-arrow-left"></i> All bookings
        </a>
        <h1 class="mb-1">{{ booking.reference }}</h1>
        <div>
            {% set badge = {
                "pending":   "warning",
                "confirmed": "success",
                "cancelled": "danger",
                "completed": "secondary",
                "refunded":  "info"
            }.get(booking.status, "secondary") %}
            <span class="badge bg-{{ badge }} fs-6">{{ booking.status }}</span>
            <span class="text-muted ms-2">{{ booking.product_type|capitalize }} #{{ booking.product_id }}</span>
        </div>
    </div>
    <div class="text-end">
        <div class="text-muted small">Total</div>
        <div class="fs-4 fw-bold">{{ booking.currency }} {{ "%.2f"|format(booking.total_amount or 0) }}</div>
        <div class="text-muted small">Created {{ booking.created_at | uk_datetime }}</div>
    </div>
</div>

{# ─── Status change form ─── #}
{% if allowed_next %}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="POST"
                  action="{{ url_for('admin.booking_status', reference=booking.reference) }}"
                  class="row g-2 align-items-end">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">New status</label>
                    <select name="status" class="form-select" required>
                        {% for s in allowed_next %}
                            <option value="{{ s }}">{{ s|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Reason (required, audit trail)</label>
                    <input type="text" name="reason" class="form-control" required maxlength="200"
                           placeholder="e.g. Customer requested upgrade approval">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100">
                        <i class="bi bi-arrow-repeat"></i> Change status
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}

{# ─── Summary panels ─── #}
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><strong>Customer</strong></div>
            <div class="card-body">
                {% if booking.user_id %}
                    <div class="mb-1">
                        <span class="badge bg-primary-subtle text-primary-emphasis">Registered user</span>
                        <span class="ms-1">User #{{ booking.user_id }}</span>
                    </div>
                {% else %}
                    <div class="mb-1"><span class="badge bg-secondary-subtle text-secondary-emphasis">Guest checkout</span></div>
                {% endif %}
                <dl class="row small mb-0">
                    <dt class="col-4 text-muted">Email</dt>
                    <dd class="col-8">{{ booking.guest_email or "—" }}</dd>
                    <dt class="col-4 text-muted">Name</dt>
                    <dd class="col-8">{{ booking.guest_name or "—" }}</dd>
                    <dt class="col-4 text-muted">Phone</dt>
                    <dd class="col-8">{{ booking.guest_phone or "—" }}</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><strong>Dates &amp; travellers</strong></div>
            <div class="card-body">
                <dl class="row small mb-0">
                    {% if booking.activity_date %}
                        <dt class="col-5 text-muted">Activity date</dt>
                        <dd class="col-7">{{ booking.activity_date | uk_date }}</dd>
                    {% endif %}
                    {% if booking.check_in_date %}
                        <dt class="col-5 text-muted">Check-in</dt>
                        <dd class="col-7">{{ booking.check_in_date | uk_date }}</dd>
                        <dt class="col-5 text-muted">Check-out</dt>
                        <dd class="col-7">{{ booking.check_out_date.strftime("%Y-%m-%d") if booking.check_out_date else "—" }}</dd>
                    {% endif %}
                    <dt class="col-5 text-muted">Adults</dt>
                    <dd class="col-7">{{ booking.travellers_adults }}</dd>
                    <dt class="col-5 text-muted">Children</dt>
                    <dd class="col-7">{{ booking.travellers_children }}</dd>
                    {% if booking.special_requests %}
                        <dt class="col-5 text-muted">Requests</dt>
                        <dd class="col-7">{{ booking.special_requests }}</dd>
                    {% endif %}
                </dl>
            </div>
        </div>
    </div>
</div>

{# ─── Items ─── #}
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white"><strong>Items</strong></div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Product</th>
                    <th>Description</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit</th>
                    <th class="text-end">Line</th>
                </tr>
            </thead>
            <tbody>
                {% for it in items %}
                    <tr>
                        <td><code>{{ it.item_type }}</code></td>
                        <td>{{ it.product_type }} #{{ it.product_id }}</td>
                        <td>{{ it.product_name_snapshot or "—" }}
                            {% if it.added_during_booking %}<span class="badge bg-info-subtle text-info-emphasis ms-1">add-on</span>{% endif %}
                        </td>
                        <td class="text-end">{{ it.quantity }}</td>
                        <td class="text-end">{{ "%.2f"|format(it.unit_price or 0) }}</td>
                        <td class="text-end fw-semibold">{{ "%.2f"|format(it.line_total or 0) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-3">No items.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ─── Travellers ─── #}
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white"><strong>Travellers</strong></div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Age</th>
                    <th>Nationality</th>
                    <th>Passport</th>
                </tr>
            </thead>
            <tbody>
                {% for t in travellers %}
                    <tr>
                        <td>
                            {{ t.full_name }}
                            {% if t.is_lead_traveller %}<span class="badge bg-primary ms-1">Lead</span>{% endif %}
                        </td>
                        <td>{{ t.traveller_type }}</td>
                        <td>{{ t.age_at_booking or "—" }}</td>
                        <td>{{ t.nationality or "—" }}</td>
                        <td><code>{{ t.passport_number or "—" }}</code></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-3">No travellers recorded.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ─── Payments ─── #}
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white"><strong>Payments</strong></div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Provider</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th class="text-end">Amount</th>
                    <th>Processed</th>
                </tr>
            </thead>
            <tbody>
                {% for p in payments %}
                    <tr>
                        <td>{{ p.id }}</td>
                        <td>{{ p.provider }}</td>
                        <td>{{ p.method }}</td>
                        <td>
                            {% set pbadge = {
                                "created":   "secondary",
                                "approved":  "info",
                                "completed": "success",
                                "failed":    "danger",
                                "cancelled": "warning",
                                "refunded":  "info"
                            }.get(p.status, "secondary") %}
                            <span class="badge bg-{{ pbadge }}">{{ p.status }}</span>
                            {% if p.failure_reason %}
                                <div class="small text-danger">{{ p.failure_reason }}</div>
                            {% endif %}
                        </td>
                        <td class="text-end">{{ p.currency }} {{ "%.2f"|format(p.amount or 0) }}</td>
                        <td class="small">{{ p.processed_at.strftime("%Y-%m-%d %H:%M") if p.processed_at else "—" }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-3">No payments.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ─── Status history ─── #}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><strong>Status history</strong></div>
    <div class="card-body">
        <ol class="list-group list-group-numbered">
            {% for h in history %}
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        <div>
                            <code>{{ h.from_status or "—" }}</code>
                            →
                            <code>{{ h.to_status }}</code>
                            {% if h.changed_by_role %}
                                <span class="text-muted small">by {{ h.changed_by_role }}{% if h.changed_by_user_id %} #{{ h.changed_by_user_id }}{% endif %}</span>
                            {% endif %}
                        </div>
                        {% if h.reason %}
                            <div class="small text-muted">{{ h.reason }}</div>
                        {% endif %}
                    </div>
                    <span class="small text-muted">{{ h.created_at | uk_datetime }}</span>
                </li>
            {% else %}
                <li class="list-group-item text-muted">No history.</li>
            {% endfor %}
        </ol>
    </div>
</div>

{# ─── Cancel shortcut ─── #}
{% if booking.status in ["pending", "confirmed"] %}
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger-subtle"><strong>Danger zone</strong></div>
        <div class="card-body">
            <form method="POST"
                  action="{{ url_for('admin.booking_cancel', reference=booking.reference) }}"
                  class="row g-2 align-items-end"
                  onsubmit="return confirm('Cancel this booking? This cannot be undone.')">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <div class="col-md-9">
                    <label class="form-label small text-muted mb-1">Cancellation reason</label>
                    <input type="text" name="reason" class="form-control" maxlength="200"
                           placeholder="Optional — defaults to 'Cancelled by admin'">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-danger w-100">
                        <i class="bi bi-x-circle"></i> Cancel booking
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}
{% endblock %}
