{% extends "admin/base.html" %}
{% block title %}Quotes — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="mb-0">Quotes</h1>
        <p class="text-muted mb-0">
            Priced quotes sent to customers.
            {{ total }} total.
        </p>
    </div>
    <div class="text-end">
        <a href="{{ url_for('admin.quote_requests') }}"
           class="btn btn-outline-primary">
            <i class="bi bi-inbox"></i> Requests inbox
        </a>
        <a href="{{ url_for('admin.quote_new') }}"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New quote
        </a>
    </div>
</div>

{# ─── Filters ─── #}
<form method="GET" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">Any status</option>
                    {% for s in ["draft", "sent", "accepted", "declined", "expired", "cancelled"] %}
                        <option value="{{ s }}" {% if status == s %}selected{% endif %}>
                            {{ s|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <select name="product_type" class="form-select">
                    <option value="">Any product</option>
                    {% for p in ["activity", "hotel", "package"] %}
                        <option value="{{ p }}" {% if product_type == p %}selected{% endif %}>
                            {{ p|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-primary w-100">Filter</button>
            </div>
            <div class="col-md-2">
                <a href="{{ url_for('admin.quote_list') }}"
                   class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </div>
    </div>
</form>

{# ─── Table ─── #}
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th class="text-end">Price</th>
                    <th>Status</th>
                    <th>Valid until</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for q in items %}
                    <tr>
                        <td>
                            <a href="{{ url_for('admin.quote_detail', reference=q.reference) }}"
                               class="fw-semibold text-decoration-none">
                                {{ q.reference }}
                            </a>
                            {% if q.sent_at %}
                                <div class="small text-muted">
                                    sent {{ q.sent_at.strftime("%Y-%m-%d") }}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <div>{{ q.customer_name or "—" }}</div>
                            <div class="small text-muted">{{ q.customer_email }}</div>
                        </td>
                        <td>
                            <span class="text-capitalize">{{ q.product_type }}</span>
                            <span class="text-muted small">#{{ q.product_id }}</span>
                            {% if q.product_name_snapshot %}
                                <div class="small text-muted text-truncate"
                                     style="max-width:220px;"
                                     title="{{ q.product_name_snapshot }}">
                                    {{ q.product_name_snapshot }}
                                </div>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {{ q.currency }} {{ "%.2f"|format(q.price or 0) }}
                        </td>
                        <td>
                            {% set badge = {
                                "draft":     "secondary",
                                "sent":      "primary",
                                "accepted":  "success",
                                "declined":  "danger",
                                "expired":   "warning",
                                "cancelled": "dark"
                            }.get(q.status, "secondary") %}
                            <span class="badge bg-{{ badge }}">{{ q.status }}</span>
                        </td>
                        <td class="small">
                            {% if q.valid_until %}
                                {{ q.valid_until.strftime("%Y-%m-%d") }}
                                {% if q.status == "sent" and q.valid_until < today() %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis ms-1">
                                        expired
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ url_for('admin.quote_detail', reference=q.reference) }}"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-file-earmark-text" style="font-size:2rem;"></i>
                            <p class="mt-2 mb-0">No quotes match these filters.</p>
                            <p class="small text-muted">
                                Start by creating a quote from a
                                <a href="{{ url_for('admin.quote_requests') }}">request</a>
                                or
                                <a href="{{ url_for('admin.quote_new') }}">from scratch</a>.
                            </p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ─── Pagination ─── #}
{% if total_pages > 1 %}
    <nav class="mt-3">
        <ul class="pagination">
            {% set qs = {} %}
            {% if status %}{% set _ = qs.update({"status": status}) %}{% endif %}
            {% if product_type %}{% set _ = qs.update({"product_type": product_type}) %}{% endif %}

            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                <a class="page-link" href="{{ url_for('admin.quote_list', page=page-1, **qs) }}">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page {{ page }} of {{ total_pages }}</span>
            </li>
            <li class="page-item {% if page >= total_pages %}disabled{% endif %}">
                <a class="page-link" href="{{ url_for('admin.quote_list', page=page+1, **qs) }}">Next</a>
            </li>
        </ul>
    </nav>
{% endif %}

{# ─── Tiny status legend ─── #}
<div class="card shadow-sm mt-4">
    <div class="card-header bg-white"><strong>Workflow</strong></div>
    <div class="card-body small">
        <ol class="mb-0">
            <li>Customer submits a quote request → appears in the
                <a href="{{ url_for('admin.quote_requests') }}">Requests inbox</a>.</li>
            <li>Admin creates a <span class="badge bg-secondary">draft</span> quote and fills in price + message.</li>
            <li>Admin clicks <strong>Send</strong> → status becomes
                <span class="badge bg-primary">sent</span>; customer receives an email with
                a link to view, accept, or decline.</li>
            <li>Customer accepts → status becomes
                <span class="badge bg-success">accepted</span> and a pending booking is created.
                Declining → <span class="badge bg-danger">declined</span>.</li>
            <li>Unanswered quotes past their validity date auto-transition to
                <span class="badge bg-warning">expired</span>.</li>
        </ol>
    </div>
</div>
{% endblock %}
