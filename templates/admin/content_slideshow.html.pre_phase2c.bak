{% extends "admin/base.html" %}
{% block title %}Home slideshow — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <a href="{{ url_for('admin.content_index') }}" class="text-decoration-none small">
            <i class="bi bi-arrow-left"></i> All site content
        </a>
        <h1 class="mb-0">Home slideshow</h1>
        <p class="text-muted mb-0">
            Upload or paste image URLs for the hero slideshow on the homepage.
            <strong>{{ active_count }}</strong> of {{ slot_count }} slots filled.
        </p>
    </div>
</div>

{% if active_count == 0 %}
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        The slideshow is empty. Upload images to the slots below and they'll
        appear on the home page hero within a page reload.
    </div>
{% endif %}

<div class="row g-3">
    {% for slot, row in rows_by_slot.items() %}
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-image"></i> Slot {{ slot }}</strong>
                    {% if row.value %}
                        <span class="badge bg-success-subtle text-success-emphasis">Active</span>
                    {% else %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Empty</span>
                    {% endif %}
                </div>

                {# Preview #}
                <div style="height:200px; background:#f5e6d3; overflow:hidden;">
                    {% if row.value %}
                        <img src="{{ row.value }}" alt="Slide {{ slot }}"
                             style="width:100%; height:100%; object-fit:cover;"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        <div class="w-100 h-100 d-none align-items-center justify-content-center text-muted">
                            <i class="bi bi-exclamation-triangle" style="font-size:2rem;"></i>
                        </div>
                    {% else %}
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                            <i class="bi bi-image" style="font-size:2.5rem;"></i>
                        </div>
                    {% endif %}
                </div>

                <div class="card-body">
                    {# Upload from computer #}
                    <form method="POST"
                          action="{{ url_for('admin.content_slideshow_upload', slot=slot) }}"
                          enctype="multipart/form-data"
                          class="mb-2">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <label class="form-label small text-muted mb-1">
                            <i class="bi bi-upload"></i> Upload image
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="file" name="file" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,.gif,image/*" required>
                            <button class="btn btn-primary">
                                <i class="bi bi-check2"></i> Save
                            </button>
                        </div>
                        <div class="form-text small">JPG, PNG, WebP, GIF. Max 10 MB.</div>
                    </form>

                    {# Or paste a URL #}
                    <form method="POST"
                          action="{{ url_for('admin.content_slideshow_update_url', slot=slot) }}">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <label class="form-label small text-muted mb-1">
                            <i class="bi bi-link-45deg"></i> Or paste a URL
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="url" name="image_url"
                                   class="form-control"
                                   value="{{ row.value or '' }}"
                                   placeholder="https://... or /static/...">
                            <button class="btn btn-outline-secondary">
                                <i class="bi bi-check2"></i>
                            </button>
                        </div>
                    </form>

                    {% if row.value %}
                        <div class="small text-muted mt-2 text-truncate"
                             title="{{ row.value }}">
                            Current: <code>{{ row.value }}</code>
                        </div>
                    {% endif %}
                </div>

                <div class="card-footer bg-white d-flex justify-content-between">
                    {% if row.value %}
                        <form method="POST"
                              action="{{ url_for('admin.content_slideshow_delete', slot=slot) }}"
                              class="d-inline"
                              onsubmit="return confirm('Clear slot {{ slot }}? The image file stays on disk, only the reference is removed.');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Clear slot
                            </button>
                        </form>
                    {% else %}
                        <span class="small text-muted">No image set</span>
                    {% endif %}
                    <a href="{{ url_for('admin.content_edit', key=row.key) }}"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil"></i> Advanced
                    </a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{# ─── Live preview widget ─── #}
<div class="card shadow-sm mt-4">
    <div class="card-header bg-white"><strong>Preview</strong></div>
    <div class="card-body text-center text-muted small">
        After uploading slides, open
        <a href="{{ url_for('public.index') }}" target="_blank">
            the home page <i class="bi bi-box-arrow-up-right"></i>
        </a>
        in a new tab to see them in action.
    </div>
</div>
{% endblock %}
