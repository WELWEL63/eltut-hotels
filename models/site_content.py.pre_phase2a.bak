"""
models/site_content.py
───────────────────────
Key/value store for admin-editable public page content.

WHY THIS EXISTS
    Admins need to change hero headlines, about-us paragraphs, footer
    text, hero images, etc., without redeploying the app. A key/value
    store with a small admin UI is the simplest way to do that.

KEY CONVENTION
    Keys use dotted namespaces so grouping is trivial:
        home.hero.title
        home.hero.subtitle
        home.hero.image_url
        about.intro
        contact.address
        footer.tagline

    The `page` column groups keys by their leading segment, so the
    admin UI can render one form per page.

CONTENT TYPES
    text       — plain text, safe to render as-is
    html       — trusted HTML, rendered with |safe
    image_url  — URL to an image, rendered into an <img>
    markdown   — markdown source, rendered by a Jinja filter

DEFAULTS
    If a key is missing from the DB, the Jinja helper `content("key",
    "Default")` falls back to the second argument — so public pages
    always render even if the admin hasn't touched them yet.
"""

from __future__ import annotations

from sqlalchemy import (
    CheckConstraint,
    ForeignKey,
    Integer,
    String,
    Text,
    UniqueConstraint,
)
from sqlalchemy.orm import Mapped, mapped_column

from models import Base, TimestampMixin


# ─── Content types ────────────────────────────────────────────────────────
CONTENT_TYPE_TEXT: str = "text"
CONTENT_TYPE_HTML: str = "html"
CONTENT_TYPE_IMAGE_URL: str = "image_url"
CONTENT_TYPE_MARKDOWN: str = "markdown"

VALID_CONTENT_TYPES: tuple[str, ...] = (
    CONTENT_TYPE_TEXT,
    CONTENT_TYPE_HTML,
    CONTENT_TYPE_IMAGE_URL,
    CONTENT_TYPE_MARKDOWN,
)

DEFAULT_CONTENT_TYPE: str = CONTENT_TYPE_TEXT


# ─── Pages ────────────────────────────────────────────────────────────────
PAGE_HOME: str = "home"
PAGE_ABOUT: str = "about"
PAGE_CONTACT: str = "contact"
PAGE_FOOTER: str = "footer"
PAGE_GLOBAL: str = "global"
PAGE_SLIDESHOW: str = "slideshow"

VALID_PAGES: tuple[str, ...] = (
    PAGE_HOME,
    PAGE_ABOUT,
    PAGE_CONTACT,
    PAGE_FOOTER,
    PAGE_GLOBAL,
    PAGE_SLIDESHOW,
)

# Number of slideshow slots. Slots beyond these are unmanaged.
SLIDESHOW_SLOT_COUNT: int = 6

DEFAULT_PAGE: str = PAGE_GLOBAL


class SiteContent(Base, TimestampMixin):
    """One editable key/value pair for the public site."""

    __tablename__ = "site_content"
    __table_args__ = (
        UniqueConstraint("key", name="site_content_key_uq"),
        CheckConstraint(
            "content_type IN ('text','html','image_url','markdown')",
            name="content_type_check",
        ),
        CheckConstraint(
            "page IN ('home','about','contact','footer','global','slideshow')",
            name="page_check",
        ),
    )

    id: Mapped[int] = mapped_column(primary_key=True)

    # ─── Identity ────────────────────────────────────────────────────
    key: Mapped[str] = mapped_column(
        String(120), nullable=False, unique=True, index=True,
    )

    # ─── Content ─────────────────────────────────────────────────────
    value: Mapped[str | None] = mapped_column(Text, nullable=True)
    content_type: Mapped[str] = mapped_column(
        String(20),
        nullable=False,
        default=DEFAULT_CONTENT_TYPE,
        server_default=DEFAULT_CONTENT_TYPE,
    )

    # ─── Admin UI grouping ──────────────────────────────────────────
    page: Mapped[str] = mapped_column(
        String(40),
        nullable=False,
        default=DEFAULT_PAGE,
        server_default=DEFAULT_PAGE,
        index=True,
    )
    label: Mapped[str] = mapped_column(String(200), nullable=False)
    notes: Mapped[str | None] = mapped_column(Text, nullable=True)
    sort_order: Mapped[int] = mapped_column(
        Integer, nullable=False, default=0, server_default="0",
    )
    # ─── Optional style overrides (nullable = "no override") ───
    font_family: Mapped[str | None] = mapped_column(String(80), nullable=True)
    font_size:   Mapped[str | None] = mapped_column(String(16), nullable=True)
    font_weight: Mapped[str | None] = mapped_column(String(8),  nullable=True)
    color:       Mapped[str | None] = mapped_column(String(16), nullable=True)
    align:       Mapped[str | None] = mapped_column(String(12), nullable=True)

    # ─── Audit ──────────────────────────────────────────────────────
    # WHY nullable + SET NULL: keep the content row even if the admin
    # who last edited it is later deleted.
    updated_by_user_id: Mapped[int | None] = mapped_column(
        ForeignKey("users.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    def __init__(self, **kwargs: object) -> None:
        for key in ("key", "content_type", "page", "label"):
            value = kwargs.get(key)
            if isinstance(value, str):
                kwargs[key] = value.strip()

        # Sensible defaults matching the DB CHECK constraints.
        if not kwargs.get("content_type"):
            kwargs["content_type"] = DEFAULT_CONTENT_TYPE
        if not kwargs.get("page"):
            kwargs["page"] = DEFAULT_PAGE
        if kwargs.get("sort_order") is None:
            kwargs["sort_order"] = 0

        super().__init__(**kwargs)

    def __repr__(self) -> str:  # pragma: no cover
        return f"<SiteContent key={self.key!r} type={self.content_type!r}>"


__all__ = [
    "SiteContent",
    "CONTENT_TYPE_TEXT",
    "CONTENT_TYPE_HTML",
    "CONTENT_TYPE_IMAGE_URL",
    "CONTENT_TYPE_MARKDOWN",
    "VALID_CONTENT_TYPES",
    "DEFAULT_CONTENT_TYPE",
    "PAGE_HOME",
    "PAGE_ABOUT",
    "PAGE_CONTACT",
    "PAGE_FOOTER",
    "PAGE_GLOBAL",
    "PAGE_SLIDESHOW",
    "VALID_PAGES",
    "DEFAULT_PAGE",
    "SLIDESHOW_SLOT_COUNT",
]
